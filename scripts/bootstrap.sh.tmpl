#!/bin/sh
# Lor host bootstrap for "{{.Host}}". Generated by Lor; re-run it to repair.
#
#   curl -fsSL '<link>' | ssh {{.Host}} sudo sh                     # install
#   curl -fsSL '<link>' | ssh {{.Host}} sudo sh -s -- --no-sudo     # no agent-sudo
#   curl -fsSL '<link>' | ssh {{.Host}} sudo sh -s -- --uninstall   # remove
#
# Options: --no-sudo, --uninstall, --keep-users (with --uninstall),
#          --force (unsupported OS, or adopt pre-existing agent users).
#
# Creates users "agent" (principal "{{.Host}}") and, unless --no-sudo,
# "agent-sudo" (principal "{{.Host}}:sudo", NOPASSWD sudo), and an sshd
# drop-in that trusts Lor's CA for those two users only. Idempotent; if
# anything fails, every change is rolled back and sshd is left as it was.

set -eu
umask 022
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C

LOR_HOST='{{.Host}}'
LOR_CA_PUB='{{.CAPub}}'
# Registered agent LAN IPs when this script was generated: validation checks
# the effective sshd settings for connections from each of them.
LOR_AGENT_ADDRS='{{.AgentAddrs}}'
LOR_DIR=/etc/ssh/lor
DROPIN_DIR=/etc/ssh/sshd_config.d
DROPIN=$DROPIN_DIR/50-lor.conf
SUDOERS=/etc/sudoers.d/50-lor-agent
SSHD_CONFIG=/etc/ssh/sshd_config
MANAGED=$LOR_DIR/managed-users
# Lor's users get UIDs/GIDs from this range, after checking that no account,
# process or file already uses the number. Other software (e.g. a container
# image running as numeric UID 1000) must never share a UID with "agent".
LOR_UID_MIN=59700
LOR_UID_MAX=59799

WANT_SUDO=1
UNINSTALL=0
KEEP_USERS=0
FORCE=0

for arg in "$@"; do
	case "$arg" in
	--no-sudo) WANT_SUDO=0 ;;
	--uninstall) UNINSTALL=1 ;;
	--keep-users) KEEP_USERS=1 ;;
	--force) FORCE=1 ;;
	-h | --help)
		sed -n '2,15p' "$0" 2>/dev/null || true
		exit 0
		;;
	*)
		echo "lor-bootstrap: unknown option: $arg" >&2
		exit 2
		;;
	esac
done

say() { printf 'lor-bootstrap: %s\n' "$*"; }
die() {
	printf 'lor-bootstrap: error: %s\n' "$*" >&2
	exit 1
}

# ---------------------------------------------------------------- rollback

BACKUP_DIR=
CREATED_USERS=
ADOPTED_USERS=
COMMITTED=0
CHANGED=0

# backup FILE: remember FILE's current state so rollback can restore it.
backup() {
	key=$(printf '%s' "$1" | tr '/' '_')
	[ -e "$BACKUP_DIR/$key.saved" ] || [ -e "$BACKUP_DIR/$key.absent" ] && return 0
	if [ -e "$1" ]; then
		cp -p "$1" "$BACKUP_DIR/$key.saved"
	else
		: >"$BACKUP_DIR/$key.absent"
	fi
	printf '%s\n' "$1" >>"$BACKUP_DIR/files"
}

rollback() {
	[ -n "$BACKUP_DIR" ] || return 0
	say "rolling back"
	if [ -f "$BACKUP_DIR/files" ]; then
		while IFS= read -r f; do
			key=$(printf '%s' "$f" | tr '/' '_')
			if [ -e "$BACKUP_DIR/$key.saved" ]; then
				cp -p "$BACKUP_DIR/$key.saved" "$f"
			else
				rm -f "$f"
			fi
		done <"$BACKUP_DIR/files"
	fi
	for u in $CREATED_USERS; do
		userdel -r "$u" >/dev/null 2>&1 || userdel "$u" >/dev/null 2>&1 || true
	done
	# Users adopted with --force get their previous password hash back.
	for u in $ADOPTED_USERS; do
		if [ -f "$BACKUP_DIR/passwd.$u" ]; then
			usermod -p "$(cat "$BACKUP_DIR/passwd.$u")" "$u" 2>/dev/null || true
		fi
	done
	if [ -d "$LOR_DIR/principals" ] && [ -z "$(ls -A "$LOR_DIR/principals" 2>/dev/null)" ]; then
		rmdir "$LOR_DIR/principals" 2>/dev/null || true
	fi
	if [ -d "$LOR_DIR" ] && [ -z "$(ls -A "$LOR_DIR" 2>/dev/null)" ]; then
		rmdir "$LOR_DIR" 2>/dev/null || true
	fi
	if sshd_bin -t >/dev/null 2>&1; then
		say "rollback complete; sshd configuration is unchanged"
	else
		say "WARNING: sshd -t fails after rollback; check $SSHD_CONFIG before restarting sshd"
	fi
}

on_exit() {
	status=$?
	if [ "$COMMITTED" -ne 1 ] && [ "$CHANGED" -eq 1 ] && [ "${ROLLED_BACK:-0}" -ne 1 ]; then
		rollback
		[ "$status" -ne 0 ] || status=1
	fi
	[ -z "$BACKUP_DIR" ] || rm -rf "$BACKUP_DIR"
	exit "$status"
}
trap on_exit EXIT
trap 'exit 130' INT TERM HUP

# ---------------------------------------------------------------- helpers

sshd_bin() {
	if command -v sshd >/dev/null 2>&1; then
		sshd "$@"
	else
		/usr/sbin/sshd "$@"
	fi
}

# sshd_version prints "MAJOR MINOR", e.g. "9 6".
sshd_version() {
	{
		sshd_bin -V 2>&1 || true
		sshd_bin -\? 2>&1 || true
	} | sed -n 's/.*OpenSSH_\([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p' | head -n 1
}

# write_file PATH MODE: write stdin to PATH atomically, with a backup first.
write_file() {
	backup "$1"
	tmp="$1.lor-tmp.$$"
	cat >"$tmp"
	chmod "$2" "$tmp"
	chown root:root "$tmp" 2>/dev/null || chown 0:0 "$tmp"
	mv -f "$tmp" "$1"
}

remove_file() {
	if [ -e "$1" ]; then
		backup "$1"
		rm -f "$1"
	fi
}

is_managed() { [ -f "$MANAGED" ] && grep -qx "$1" "$MANAGED"; }

user_exists() { id "$1" >/dev/null 2>&1; }

# uid_in_use N: true if an account, group, running process or file in the
# usual data locations already uses N as a UID or GID.
uid_in_use() {
	getent passwd "$1" >/dev/null 2>&1 && return 0
	getent group "$1" >/dev/null 2>&1 && return 0
	for d in /proc/[0-9]*; do
		awk -v n="$1" '/^(Uid|Gid):/ { for (i = 2; i <= NF; i++) if ($i == n) f = 1 } END { exit !f }' "$d/status" 2>/dev/null && return 0
	done
	for p in /home /opt /srv /var/lib /var/opt; do
		[ -d "$p" ] || continue
		[ -n "$(find "$p" -xdev \( -uid "$1" -o -gid "$1" \) -print -quit 2>/dev/null)" ] && return 0
	done
	return 1
}

pick_uid() {
	n=$LOR_UID_MIN
	while [ "$n" -le "$LOR_UID_MAX" ]; do
		uid_in_use "$n" || {
			printf '%s\n' "$n"
			return 0
		}
		n=$((n + 1))
	done
	return 1
}

in_lor_range() { [ "$1" -ge "$LOR_UID_MIN" ] && [ "$1" -le "$LOR_UID_MAX" ]; }

create_user() {
	u=$1
	uid=$(pick_uid) || die "no free UID in $LOR_UID_MIN-$LOR_UID_MAX for user $u"
	getent group "$u" >/dev/null 2>&1 && die "a group named $u already exists; remove it or adopt the account with --force"
	useradd --create-home --shell /bin/bash --comment "Lor agent" --uid "$uid" --user-group "$u"
	CREATED_USERS="$CREATED_USERS $u"
	say "created user $u (UID $uid)"
}

ensure_user() {
	u=$1
	if user_exists "$u"; then
		if ! is_managed "$u"; then
			[ "$FORCE" -eq 1 ] || die "user $u already exists and wasn't created by Lor; re-run with --force to adopt it"
			say "adopting existing user $u (--force)"
			getent shadow "$u" | cut -d: -f2 >"$BACKUP_DIR/passwd.$u"
			ADOPTED_USERS="$ADOPTED_USERS $u"
		elif ! in_lor_range "$(id -u "$u")"; then
			# Installed by an older Lor with a default UID that other software
			# (often a container's numeric user) may share: recreate it.
			old_uid=$(id -u "$u")
			say "user $u has UID $old_uid, outside Lor's range $LOR_UID_MIN-$LOR_UID_MAX; recreating it"
			delete_user "$u"
			create_user "$u"
		fi
	else
		create_user "$u"
	fi
	# '*' disables password login without "locking" the account.
	usermod -p '*' "$u"
}

# delete_user removes an account after ending only its SSH sessions. Other
# processes running with the same numeric UID are left alone.
delete_user() {
	u=$1
	uid=$(id -u "$u")
	kill_ssh_sessions "$uid"
	others=$(count_uid_processes "$uid")
	userdel -r "$u" >/dev/null 2>&1 || userdel -f -r "$u" >/dev/null 2>&1 || userdel -f "$u"
	if [ "$others" -gt 0 ]; then
		say "left $others process(es) running as UID $uid alone: they aren't Lor SSH sessions"
	fi
}

remove_user() {
	u=$1
	user_exists "$u" || return 0
	if ! is_managed "$u" && [ "$FORCE" -ne 1 ]; then
		say "leaving user $u alone: it wasn't created by Lor"
		return 0
	fi
	delete_user "$u"
	say "removed user $u"
}

managed_list() {
	{
		[ -f "$MANAGED" ] && cat "$MANAGED"
		for u in "$@"; do printf '%s\n' "$u"; done
	} | grep -v '^$' | sort -u
}

# find_sshd_pid prints the listening sshd's PID: the pid file, else the
# oldest "sshd" process (works without procps).
find_sshd_pid() {
	if [ -f /run/sshd.pid ]; then
		pid=$(cat /run/sshd.pid 2>/dev/null || true)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			printf '%s\n' "$pid"
			return 0
		fi
	fi
	for d in /proc/[0-9]*; do
		[ "$(cat "$d/comm" 2>/dev/null)" = sshd ] || continue
		ppid=$(sed -n 's/^PPid:[[:space:]]*//p' "$d/status" 2>/dev/null)
		[ "$(cat "/proc/$ppid/comm" 2>/dev/null)" = sshd ] && continue
		printf '%s\n' "${d#/proc/}"
		return 0
	done
}

# from_ssh PID: true if PID descends from an sshd process (a login session).
from_ssh() {
	p=$1
	i=0
	while [ "$p" -gt 1 ] && [ "$i" -lt 64 ]; do
		p=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$p/status" 2>/dev/null)
		[ -n "$p" ] || return 1
		case "$(cat "/proc/$p/comm" 2>/dev/null)" in
		sshd | sshd-session | sshd-auth) return 0 ;;
		esac
		i=$((i + 1))
	done
	return 1
}

uid_pids() {
	for d in /proc/[0-9]*; do
		[ "$(awk '/^Uid:/ { print $2 }' "$d/status" 2>/dev/null)" = "$1" ] && printf '%s\n' "${d#/proc/}"
	done
	return 0
}

# kill_ssh_sessions UID ends the user's SSH sessions (processes running as
# UID that descend from sshd), and nothing else.
kill_ssh_sessions() {
	for pid in $(uid_pids "$1"); do
		if from_ssh "$pid"; then
			kill -KILL "$pid" 2>/dev/null || true
		fi
	done
	return 0
}

count_uid_processes() {
	uid_pids "$1" | wc -l | tr -d ' '
}

reload_sshd() {
	if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
		unit=ssh.service
		systemctl cat ssh.service >/dev/null 2>&1 || unit=sshd.service
		if systemctl is-active --quiet ssh.socket 2>/dev/null; then
			# Socket-activated (Ubuntu >= 22.10): reload only if running; a
			# stopped ssh.service reads the new config when it next starts.
			if systemctl is-active --quiet "$unit"; then
				systemctl reload "$unit" || return 1
				say "reloaded $unit"
			else
				say "$unit is socket-activated and not running; new connections use the new config"
			fi
			return 0
		fi
		if systemctl is-active --quiet "$unit"; then
			systemctl reload "$unit" || return 1
			say "reloaded $unit"
			return 0
		fi
	fi
	pid=$(find_sshd_pid)
	if [ -n "$pid" ]; then
		kill -HUP "$pid" || return 1
		say "sent SIGHUP to sshd (pid $pid)"
	else
		say "sshd is not running; it will use the new config when it starts"
	fi
}

validate() {
	sshd_bin -t || die "sshd -t failed"
	# Check the effective settings for every connection context an agent can
	# use (loopback plus each registered agent IP), so an earlier
	# "Match Address ..." block can't quietly override Lor's.
	for u in "$@"; do
		for addr in 127.0.0.1 $LOR_AGENT_ADDRS; do
			out=$(sshd_bin -T -C "user=$u,host=lor-validate,addr=$addr" 2>&1) || die "sshd -T failed for $u from $addr: $out"
			for want in \
				"authorizedkeysfile none" \
				"authorizedkeyscommand none" \
				"authorizedprincipalscommand none" \
				"trustedusercakeys $LOR_DIR/ca.pub" \
				"authorizedprincipalsfile $LOR_DIR/principals/%u" \
				"passwordauthentication no"; do
				printf '%s\n' "$out" | grep -qix "$want" ||
					die "validation failed for user $u from $addr: sshd -T doesn't show '$want' (another sshd setting overrides Lor's)"
			done
		done
	done
}

print_fingerprint() {
	if [ -f /etc/ssh/ssh_host_ed25519_key.pub ]; then
		say "host ed25519 key (compare with Lor's scan):"
		ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
	else
		say "WARNING: /etc/ssh/ssh_host_ed25519_key.pub not found; Lor needs an ed25519 host key"
	fi
}

# ---------------------------------------------------------------- preflight

[ "$(id -u)" -eq 0 ] || die "must run as root (pipe it to 'sudo sh')"
command -v useradd >/dev/null 2>&1 || die "useradd not found"

ver=$(sshd_version)
[ -n "$ver" ] || die "can't find the OpenSSH server (sshd)"
# shellcheck disable=SC2086 # split "MAJOR MINOR"
set -- $ver
SSH_MAJOR=$1
SSH_MINOR=$2
if [ "$SSH_MAJOR" -lt 8 ] || { [ "$SSH_MAJOR" -eq 8 ] && [ "$SSH_MINOR" -lt 9 ]; }; then
	die "OpenSSH $SSH_MAJOR.$SSH_MINOR is too old; Lor needs 8.9 or newer"
fi
NEW_TIMEOUTS=0
# OpenSSH before 10.5 ignores ChannelTimeout inside Match blocks (fixed in
# 10.5), so Lor's idle timeout is written but not enforced there.
TIMEOUT_ENFORCED=0
if [ "$SSH_MAJOR" -gt 10 ] || { [ "$SSH_MAJOR" -eq 10 ] && [ "$SSH_MINOR" -ge 5 ]; }; then
	TIMEOUT_ENFORCED=1
fi
if [ "$SSH_MAJOR" -gt 9 ] || { [ "$SSH_MAJOR" -eq 9 ] && [ "$SSH_MINOR" -ge 2 ]; }; then
	NEW_TIMEOUTS=1
fi

OS_ID=unknown
OS_VERSION=
if [ -r /etc/os-release ]; then
	# shellcheck disable=SC1091
	OS_ID=$(. /etc/os-release && printf '%s' "${ID:-unknown}")
	# shellcheck disable=SC1091
	OS_VERSION=$(. /etc/os-release && printf '%s' "${VERSION_ID:-}")
fi
case "$OS_ID:$OS_VERSION" in
debian:12 | debian:13 | ubuntu:22.04 | ubuntu:24.04 | ubuntu:26.04) ;;
*)
	[ "$FORCE" -eq 1 ] || die "unsupported OS '$OS_ID $OS_VERSION' (tier 1: Proxmox VE 8/9, Debian 12/13, Ubuntu 22.04/24.04/26.04); re-run with --force to try anyway"
	say "unsupported OS '$OS_ID $OS_VERSION', continuing because of --force"
	;;
esac
say "host $LOR_HOST: $OS_ID $OS_VERSION, OpenSSH $SSH_MAJOR.$SSH_MINOR"

if [ "$WANT_SUDO" -eq 1 ] && [ "$UNINSTALL" -eq 0 ]; then
	command -v sudo >/dev/null 2>&1 || die "sudo is not installed; install it (apt install sudo) or re-run with --no-sudo"
	command -v visudo >/dev/null 2>&1 || die "visudo is not installed; install sudo (or sudo-rs) or re-run with --no-sudo"
	[ -d /etc/sudoers.d ] || die "/etc/sudoers.d doesn't exist; check the sudo installation or re-run with --no-sudo"
	say "sudo: $(sudo --version 2>/dev/null | head -n 1)"
fi

[ -f "$SSHD_CONFIG" ] || die "$SSHD_CONFIG not found"
# sshd -t needs the privilege separation directory, which may be missing
# while a socket-activated sshd isn't running.
[ -d /run/sshd ] || { mkdir -p /run/sshd && chmod 0755 /run/sshd; }
sshd_bin -t >/dev/null 2>&1 || die "the current sshd configuration is invalid (sshd -t fails); fix it first"

BACKUP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/lor-bootstrap.XXXXXX")
: >"$BACKUP_DIR/files"

# ---------------------------------------------------------------- uninstall

if [ "$UNINSTALL" -eq 1 ]; then
	CHANGED=1
	remove_file "$DROPIN"
	remove_file "$SUDOERS"
	sshd_bin -t || die "sshd -t failed after removing Lor's drop-in"
	reload_sshd || die "reloading sshd failed"
	# sshd no longer trusts Lor's CA; nothing below can affect sshd.
	COMMITTED=1
	if [ "$KEEP_USERS" -eq 0 ]; then
		remove_user agent-sudo
		remove_user agent
	fi
	rm -rf "$LOR_DIR"
	say "Lor removed from $LOR_HOST"
	exit 0
fi

# ---------------------------------------------------------------- install

# Make sure the drop-in directory is included, near the top of sshd_config.
if ! grep -Eq '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf([[:space:]]|$)' "$SSHD_CONFIG"; then
	CHANGED=1
	backup "$SSHD_CONFIG"
	tmp="$SSHD_CONFIG.lor-tmp.$$"
	{
		echo "Include /etc/ssh/sshd_config.d/*.conf"
		cat "$SSHD_CONFIG"
	} >"$tmp"
	chmod 0644 "$tmp"
	mv -f "$tmp" "$SSHD_CONFIG"
	say "added 'Include /etc/ssh/sshd_config.d/*.conf' to the top of $SSHD_CONFIG (backup kept during the run)"
fi

CHANGED=1
mkdir -p "$DROPIN_DIR" "$LOR_DIR/principals"
chmod 0755 "$LOR_DIR" "$LOR_DIR/principals"

ensure_user agent
users="agent"
if [ "$WANT_SUDO" -eq 1 ]; then
	ensure_user agent-sudo
	users="agent agent-sudo"
fi

printf '%s\n' "$LOR_CA_PUB" | write_file "$LOR_DIR/ca.pub" 0644
printf '%s\n' "$LOR_HOST" | write_file "$LOR_DIR/principals/agent" 0644
if [ "$WANT_SUDO" -eq 1 ]; then
	printf '%s\n' "$LOR_HOST:sudo" | write_file "$LOR_DIR/principals/agent-sudo" 0644
	printf '%s\n' "# Managed by Lor. Re-run bootstrap instead of editing." "agent-sudo ALL=(ALL:ALL) NOPASSWD: ALL" |
		write_file "$SUDOERS.lor-check" 0440
	visudo -cf "$SUDOERS.lor-check" >/dev/null || die "visudo rejected the sudoers drop-in"
	backup "$SUDOERS"
	mv -f "$SUDOERS.lor-check" "$SUDOERS"
else
	remove_file "$LOR_DIR/principals/agent-sudo"
	remove_file "$SUDOERS"
fi
# shellcheck disable=SC2086 # $users is a word list
managed_list $users | write_file "$MANAGED" 0644

{
	echo "# Managed by Lor. Re-run bootstrap instead of editing."
	echo "Match User agent,agent-sudo"
	echo "    TrustedUserCAKeys $LOR_DIR/ca.pub"
	echo "    AuthorizedPrincipalsFile $LOR_DIR/principals/%u"
	echo "    AuthorizedKeysFile none"
	echo "    AuthorizedKeysCommand none"
	echo "    AuthorizedPrincipalsCommand none"
	echo "    PasswordAuthentication no"
	echo "    KbdInteractiveAuthentication no"
	echo "    DisableForwarding yes"
	echo "    PermitUserRC no"
	if [ "$NEW_TIMEOUTS" -eq 1 ]; then
		echo "    ChannelTimeout session=15m"
		echo "    UnusedConnectionTimeout 5m"
	fi
	echo "Match all"
} | write_file "$DROPIN" 0644

# shellcheck disable=SC2086
validate $users

# --no-sudo on an existing host removes agent-sudo (after validation).
if [ "$WANT_SUDO" -eq 0 ] && user_exists agent-sudo && is_managed agent-sudo; then
	REMOVE_SUDO_USER=1
else
	REMOVE_SUDO_USER=0
fi

# Reload before committing: if it fails, the rollback restores the previous
# files and reloads again.
if ! reload_sshd; then
	rollback
	reload_sshd || true
	ROLLED_BACK=1
	die "reloading sshd failed; the previous configuration was restored"
fi
COMMITTED=1

if [ "$REMOVE_SUDO_USER" -eq 1 ]; then
	remove_user agent-sudo
fi
if [ "$WANT_SUDO" -eq 0 ]; then
	managed_list agent | grep -vx agent-sudo >"$MANAGED.tmp" || true
	mv -f "$MANAGED.tmp" "$MANAGED"
fi

say "Lor installed on $LOR_HOST (users: $users)"
if [ "$TIMEOUT_ENFORCED" -eq 0 ]; then
	say "note: OpenSSH $SSH_MAJOR.$SSH_MINOR doesn't enforce ChannelTimeout for Lor's users (fixed in OpenSSH 10.5); idle sessions stay open until closed"
fi
print_fingerprint
