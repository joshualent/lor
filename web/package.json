		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/svelte-query": "^6.3.5",
		"@types/node": "^22",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"eslint": "^10.4.1",
